# Managed by YunoHost: manual changes are overwritten on upgrade
# Reference: https://radicale.org/v3.html#configuration

[server]
hosts = 127.0.0.1:__PORT__
max_connections = 20
# Same as client_max_body_size in the NGINX configuration
max_content_length = 100000000
timeout = 30

[encoding]
request = utf-8
stock = utf-8

[auth]
type = ldap
ldap_uri = ldap://127.0.0.1:389
ldap_base = ou=users,dc=yunohost,dc=org
# Users allowed on the permission __APP__.main, by username or email address
ldap_filter = (&(objectClass=posixAccount)(|(uid={0})(mail={0}))(permission=cn=__APP__.main,ou=permission,dc=yunohost,dc=org))
ldap_user_attribute = uid
cache_logins = true
cache_successful_logins_expiry = 15
cache_failed_logins_expiry = 90
delay = 1
realm = Radicale - Password Required

[rights]
type = owner_only

[storage]
type = multifilesystem
filesystem_folder = __DATA_DIR__/collections
hook = __STORAGE_HOOK__
predefined_collections = {"calendar": {"tag": "VCALENDAR", "D:displayname": "Calendar", "C:supported-calendar-component-set": "VEVENT,VTODO,VJOURNAL"}, "contacts": {"tag": "VADDRESSBOOK", "D:displayname": "Contacts"}}

[web]
type = internal

[logging]
level = info
mask_passwords = True
