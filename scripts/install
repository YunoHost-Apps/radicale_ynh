#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# RETRIEVE ARGUMENTS FROM THE MANIFEST
#=================================================

# Retrieve the version number in the manifest file.
version=$(ynh_app_upstream_version)

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

# Create the directory and set the path in the config
mkdir -p "$install_dir/collections"

# Copy files to the right place
cp ../conf/radicale.wsgi $install_dir

# Copy extra files
cp -a ../sources_radicale/. "$install_dir"

if [ $infcloud -eq 1 ]
then
	# Download and uncompress the source into install_dir
	ynh_setup_source --dest_dir="$install_dir/infcloud"
fi

chmod 750 "$install_dir"
chmod -R o-rwx "$install_dir"
chown -R $app:www-data "$install_dir"

# Set default permissions as radicale do.
chmod 666 -R $install_dir/default_collections
chmod 777 $install_dir/default_collections $install_dir/default_collections/USER

#=================================================
# NGINX CONFIGURATION
#=================================================
ynh_script_progression "Configuring NGINX web server..."

# Create a dedicated NGINX config
ynh_config_add_nginx

if [ $infcloud -eq 1 ]
then
	# Add InfCloud in NGINX config
	ynh_replace --match="#INFCLOUD#" --replace="" --file="/etc/nginx/conf.d/$domain.d/$app.conf"
	ynh_store_file_checksum "/etc/nginx/conf.d/$domain.d/$app.conf"
fi

#=================================================
# PHP-FPM CONFIGURATION
#=================================================

if [ $infcloud -eq 1 ]
then
	ynh_script_progression "Configuring PHP-FPM..."

	# Create a dedicated PHP-FPM config
	ynh_config_add_phpfpm
fi

#=================================================
# INSTALL RADICALE IN A VIRTUALENV
#=================================================
ynh_script_progression "Install Radicale in a virtualenv"

# Init virtualenv
python3 -m venv $install_dir/radicale
$install_dir/radicale/bin/pip install radicale==$version python-ldap

# regex.py file is patched to fix the awful commit e807c3d35bea9cfcfcacac83b1b17d748ea15a39 that stop the reading of "rights" file after the first match.
# mv "$install_dir/regex.py" /opt/yunohost/$app/lib/python*/site-packages/radicale/rights/regex.py

# useradd radicale -d /opt/yunohost/$app
chown $app: -R $install_dir/radicale

find $install_dir/radicale/ -type d -exec chmod 2755 {} \;
find $install_dir/radicale/ -type f -exec chmod g+r,o+r {} \;

#=================================================
# ADD A CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration..."

mkdir -p /etc/$app

ynh_config_add --template="config" --destination="/etc/$app/config"

ynh_config_add --template="logging" --destination="/etc/$app/logging"

ynh_config_add --template="rights" --destination="/etc/$app/rights"

chmod 755 /etc/$app/
#REMOVEME? Assuming the file is setup using ynh_config_add, the proper chmod/chowns are now already applied and it shouldn't be necessary to tweak perms | chmod 644 /etc/$app/*

if [ $infcloud -eq 1 ]
then
	# InfCloud configuration
	# Set language
	case "$language" in
		"Czech") language="cs_CZ"
		;;
		"Danish") language="da_DK"
		;;
		"German") language="de_DE"
		;;
		"English/US") language="en_US"
		;;
		"Spanish") language="es_ES"
		;;
		"French") language="fr_FR"
		;;
		"Italian") language="it_IT"
		;;
		"Japan") language="ja_JP"
		;;
		"Hungarian") language="hu_HU"
		;;
		"Dutch") language="nl_NL"
		;;
		"Slovak") language="sk_SK"
		;;
		"Turkish") language="tr_TR"
		;;
		"Russian") language="ru_RU"
		;;
		"Ukrainian") language="uk_UA"
		;;
		"Chinese") language="zh_CN"
		;;
	esac
	ynh_app_setting_set --key=language --value=$language
	timezone=$(cat /etc/timezone)
	ynh_config_add --template="config.js" --destination="$install_dir/infcloud/config.js"

	chmod 440 "$install_dir/infcloud/config.js"
	chown $app:www-data "$install_dir/infcloud/config.js"
fi

#=================================================
# GENERATE CALENDARS AND ADDRESS BOOKS FOR ALL USERS
#=================================================
ynh_script_progression "Generate calendars and address books for all users"

# Create default calendars and address books for each users
while read user
do
		cp -a $install_dir/default_collections/USER $install_dir/collections/$user
		cp -a $install_dir/default_collections/USER.props $install_dir/collections/$user.props
# List all users and remove the space after username
done <<< "$(yunohost user list | grep username | cut -d ":" -f 2 | cut -c 2-)"

#=================================================
# PREPARE THE HOOKS
#=================================================

# Modify the hooks for create user collections and to remove them.
ynh_replace --match="__INSTALL_DIR__" --replace="$install_dir" --file="../hooks/post_user_create"
ynh_replace --match="__INSTALL_DIR__" --replace="$install_dir" --file="../hooks/post_user_delete"

#=================================================
# SETUP SYSTEMD
#=================================================
ynh_script_progression "Configuring $app's systemd service..."

ynh_config_add --template="radicale.ini" --destination="/etc/uwsgi/apps-available/$app.ini"
ln -s /etc/uwsgi/apps-available/$app.ini /etc/uwsgi/apps-enabled/

#=================================================
# SETUP LOGROTATE
#=================================================
ynh_script_progression "Configuring log rotation..."

mkdir -p /var/log/$app
touch /var/log/$app/$app.log
chown $app -R /var/log/$app

# Use logrotate to manage application logfile(s)
ynh_config_add_logrotate

#=================================================
# INTEGRATE SERVICE IN YUNOHOST
#=================================================
#ynh_script_progression "Integrating service in YunoHost..."

#yunohost service add $app --log="/var/log/uwsgi/app/radicale.log" --name="Radicale"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

# Start a systemd service
ynh_systemctl --service=uwsgi --action="restart"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
