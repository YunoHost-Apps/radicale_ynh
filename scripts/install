#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

git_history=1
ynh_app_setting_set --key=git_history --value="$git_history"
sharing_users=0
ynh_app_setting_set --key=sharing_users --value="$sharing_users"
sharing_links=0
ynh_app_setting_set --key=sharing_links --value="$sharing_links"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Installing Radicale in a Python virtual environment..."

_radicale_install_venv

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

_radicale_add_config

# Data kept after a failed upgrade from 1.x (the marker means an interrupted conversion)
if [ -d "$data_dir/radicale1-backup/collections" ] \
    && { [ ! -d "$data_dir/collections/collection-root" ] || [ -e "$data_dir/.radicale1-migration-in-progress" ]; }; then
    ynh_script_progression "Converting the Radicale 1.x data found in $data_dir/radicale1-backup..."
    _radicale_convert_v1_data _radicale_v1_install_die
fi

_radicale_prepare_data_dir
_radicale_init_git

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

_radicale_ensure_public_access

_radicale_remove_v1_remains

ynh_config_add_nginx
_radicale_add_wellknown

ynh_config_add_logrotate

ynh_config_add_systemd

yunohost service add "$app" --description="CalDAV and CardDAV server" --log="/var/log/$app/$app.log"

ynh_config_add_fail2ban --logpath="/var/log/$app/$app.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --wait_until="Radicale server ready"

_radicale_v1_migration_done

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
