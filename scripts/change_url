#!/bin/bash

source /usr/share/yunohost/helpers

#=================================================
# MODIFY URL IN NGINX CONF
#=================================================
ynh_script_progression "Updating NGINX web server configuration..."

ynh_config_change_url_nginx

#=================================================
# MODIFY CONFIG FILES
#=================================================

ynh_replace --match="^base_prefix = $old_path.*" --replace="base_prefix = ${new_path%/}/" --file="/etc/$app/config"

if [ $infcloud -eq 1 ]; then
	ynh_replace --match="href: 'https://$old_domain$old_path'," --replace="href: 'https://$new_domain${new_path%/}/'," --file="$install_dir/infcloud/config.js"
fi

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

# Start a systemd service
ynh_systemctl --service=uwsgi --action="restart"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Change of URL completed for $app"
