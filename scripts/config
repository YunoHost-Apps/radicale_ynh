#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

ynh_abort_if_errors

#=================================================
# SPECIFIC SETTERS FOR TOML SHORT KEYS
#=================================================

set__git_history() {
    ynh_app_setting_set --key=git_history --value="$git_history"

    _radicale_add_config
    _radicale_init_git
}

#=================================================
ynh_app_config_run "$1"
