#!/bin/bash

source /usr/share/yunohost/helpers

ynh_script_progression "Checking version..."

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

ynh_app_setting_delete --key=unprotected_regex

if [ -d /usr/local/radicale ]
then
	mkdir -p /opt/yunohost
	mv /usr/local/radicale /opt/yunohost/
fi

# Fix infcloud as a boolean
if [ "$infcloud" = "Yes" ]; then
	ynh_app_setting_set --key=infcloud --value=1
	infcloud=1
elif [ "$infcloud" = "No" ]; then
	ynh_app_setting_set --key=infcloud --value=0
	infcloud=0
fi

# If overwrite_logging doesn't exist, create it
ynh_app_setting_set_default --key=overwrite_logging --value=1

# If overwrite_config doesn't exist, create it
ynh_app_setting_set_default --key=overwrite_config --value=1

# If overwrite_infcloud doesn't exist, create it
ynh_app_setting_set_default --key=overwrite_infcloud --value=1

# If overwrite_nginx doesn't exist, create it
ynh_app_setting_set_default --key=overwrite_nginx --value=1

# If overwrite_phpfpm doesn't exist, create it
ynh_app_setting_set_default --key=overwrite_phpfpm --value=1

if [ -z "${firstdayofweek:-}"]; then
	firstdayofweek="1"
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================

# Retrieve the version number in the manifest file.
version=$(ynh_app_upstream_version)


ynh_script_progression "Upgrading source files..."

# Copy files to the right place
mkdir -p $install_dir/collections

# Copy files to the right place
cp ../conf/radicale.wsgi $install_dir

# Copy extra files
cp -a ../sources_radicale/. "$install_dir"

if [ $infcloud -eq 1 ]
then
	# Download and uncompress the source into install_dir
	ynh_setup_source --dest_dir="$install_dir/infcloud" --keep="config.js"
fi

chmod 750 "$install_dir"
chmod -R o-rwx "$install_dir"
chown -R $app:www-data "$install_dir"
chmod 666 -R $install_dir/default_collections
chmod 777 $install_dir/default_collections $install_dir/default_collections/USER

#=================================================
# NGINX CONFIGURATION
#=================================================

# Overwrite the NGINX configuration only if it's allowed
if [ $overwrite_nginx -eq 1 ]
then
	ynh_script_progression "Upgrading NGINX web server configuration..."

	# Create a dedicated NGINX config
	ynh_config_add_nginx
	if [ $infcloud -eq 1 ]
	then
		# Add InfCloud in NGINX config
		ynh_replace --match="#INFCLOUD#" --replace="" --file="/etc/nginx/conf.d/$domain.d/$app.conf"
	fi
	ynh_store_file_checksum "/etc/nginx/conf.d/$domain.d/$app.conf"
fi

#=================================================
# PHP-FPM CONFIGURATION
#=================================================

if [ $infcloud -eq 1 ]
then
	# Overwrite the php-fpm configuration only if it's allowed
	if [ $overwrite_phpfpm -eq 1 ]
	then
		# Create a dedicated PHP-FPM config
		ynh_config_add_phpfpm
	fi
fi

#=================================================
# UPGRADE RADICALE IN ITS VIRTUALENV
#=================================================

# FIXME: this is still supported but the recommendation is now to *always* re-setup the app sources wether or not the upstream sources changed
if ynh_app_upstream_version_changed
then
	ynh_script_progression "Upgrade Radicale in its virtualenv"
	python3 -m venv $install_dir/radicale
	$install_dir/radicale/bin/pip install -U radicale==$version python-ldap

	# regex.py file is patched to fix the awful commit e807c3d35bea9cfcfcacac83b1b17d748ea15a39 that stop the reading of "rights" file after the first match.
	# mv "$install_dir/regex.py" /opt/yunohost/$app/lib/python*/site-packages/radicale/rights/regex.py

	# useradd radicale -d /opt/yunohost/$app
	chown $app: -R $install_dir/radicale

	find $install_dir/radicale/ -type d -exec chmod 2755 {} \;
	find $install_dir/radicale/ -type f -exec chmod g+r,o+r {} \;
fi

#=================================================
# CONFIGURE RADICALE
#=================================================
ynh_script_progression "Reconfigure Radicale"

# Overwrite the logging config file only if it's allowed
if [ $overwrite_logging -eq 1 ]
then
	ynh_config_add --template="logging" --destination="/etc/$app/logging"
fi

# Overwrite the config file only if it's allowed
if [ $overwrite_config -eq 1 ]
then
	ynh_config_add --template="config" --destination="/etc/$app/config"
fi

chmod 755 /etc/$app/
#REMOVEME? Assuming the file is setup using ynh_config_add, the proper chmod/chowns are now already applied and it shouldn't be necessary to tweak perms | chmod 644 /etc/$app/*

# Overwrite the InfCloud config file only if it's allowed
if [ $infcloud -eq 1 ]
then
	if [ $overwrite_infcloud -eq 1 ]
	then
		# InfCloud configuration
		timezone=$(cat /etc/timezone)
		ynh_config_add --template="config.js" --destination="$install_dir/infcloud/config.js"

		# # Optional parameters from config-panel feature
		# if [ -n "$firstdayofweek" ]; then
		# 	ynh_replace --match="\(^var globalDatepickerFirstDayOfWeek=\).*" --replace="\1$firstdayofweek;" --file="$install_dir/infcloud/config.js"
		# fi
		# if [ -n "$activeview" ]; then
		# 	ynh_replace --match="\(^var globalActiveView=\).*" --replace="\1\'$activeview\';" --file="$install_dir/infcloud/config.js"
		# fi
		# if [ -n "$openformmode" ]; then
		# 	ynh_replace --match="\(^var globalOpenFormMode=\).*" --replace="\1\'$openformmode\';" --file="$install_dir/infcloud/config.js"
		# fi
		# if [ -n "$startofbusiness" ]; then
		# 	ynh_replace --match="\(^var globalCalendarStartOfBusiness=\).*" --replace="\1$startofbusiness;" --file="$install_dir/infcloud/config.js"
		# fi
		# if [ -n "$endofbusiness" ]; then
		# 	ynh_replace --match="\(^var globalCalendarEndOfBusiness=\).*" --replace="\1$endofbusiness;" --file="$install_dir/infcloud/config.js"
		# fi
		# if [ -n "$defaulteventduration" ]; then
		# 	ynh_replace --match="\(^var globalDefaultEventDuration=\).*" --replace="\1$defaulteventduration;" --file="$install_dir/infcloud/config.js"
		# fi
		# Recalculate and store the checksum of the file for the next upgrade.
		# ynh_store_file_checksum "$install_dir/infcloud/config.js"
		#REMOVEME? Assuming the file is setup using ynh_config_add, the proper chmod/chowns are now already applied and it shouldn't be necessary to tweak perms | chmod 440 "$install_dir/infcloud/config.js"
		#REMOVEME? Assuming the file is setup using ynh_config_add, the proper chmod/chowns are now already applied and it shouldn't be necessary to tweak perms | chown $app:www-data "$install_dir/infcloud/config.js"
	fi
fi

#=================================================
# CONFIGURE UWSGI FOR RADICALE
#=================================================

ynh_config_add --template="radicale.ini" --destination="/etc/uwsgi/apps-available/$app.ini"

#=================================================
# PREPARE THE HOOKS
#=================================================

# Modify the hooks for create user collections and to remove them.
ynh_replace --match="__INSTALL_DIR__" --replace="$install_dir" --file="../hooks/post_user_create"
ynh_replace --match="__INSTALL_DIR__" --replace="$install_dir" --file="../hooks/post_user_delete"

#=================================================
# SETUP LOGROTATE
#=================================================
ynh_script_progression "Upgrading logrotate configuration..."

mkdir -p /var/log/$app
touch /var/log/$app/$app.log
chown radicale -R /var/log/$app

# Use logrotate to manage app-specific logfile(s)
ynh_config_add_logrotate

#=================================================
# INTEGRATE SERVICE IN YUNOHOST
#=================================================
ynh_script_progression "Integrating service in YunoHost..."

# yunohost service add $app --log="/var/log/uwsgi/app/radicale.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service=uwsgi --action="restart"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
