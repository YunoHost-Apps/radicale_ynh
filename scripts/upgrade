#!/bin/bash

source /usr/share/yunohost/helpers

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

timezone=$(cat /etc/timezone)

ynh_app_setting_delete --key=unprotected_regex

if [ -d /usr/local/radicale ]
then
	mkdir -p /opt/yunohost
	mv /usr/local/radicale /opt/yunohost/
fi

# Fix infcloud as a boolean
if [ "$infcloud" = "Yes" ]; then
	ynh_app_setting_set --key=infcloud --value=1
	infcloud=1
elif [ "$infcloud" = "No" ]; then
	ynh_app_setting_set --key=infcloud --value=0
	infcloud=0
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# Copy files to the right place
mkdir -p $install_dir/collections

# Copy files to the right place
cp ../conf/radicale.wsgi $install_dir

# Copy extra files
cp -a ../sources/extra_files_radicale/. "$install_dir"

if [ $infcloud -eq 1 ]
then
	# Download and uncompress the source into install_dir
	ynh_setup_source --dest_dir="$install_dir/infcloud" --keep="config.js"
fi

chmod 750 "$install_dir"
chmod -R o-rwx "$install_dir"
chown -R $app:www-data "$install_dir"
chmod 666 -R $install_dir/default_collections
chmod 777 $install_dir/default_collections $install_dir/default_collections/USER

#=================================================
# NGINX CONFIGURATION
#=================================================

# Overwrite the NGINX configuration only if it's allowed
if [ $overwrite_nginx -eq 1 ]
then
	# Create a dedicated NGINX config
	ynh_config_add_nginx
	if [ $infcloud -eq 1 ]
	then
		# Add InfCloud in NGINX config
		ynh_replace --match="#INFCLOUD#" --replace="" --file="/etc/nginx/conf.d/$domain.d/$app.conf"
	fi
	ynh_store_file_checksum "/etc/nginx/conf.d/$domain.d/$app.conf"
fi

#=================================================
# PHP-FPM CONFIGURATION
#=================================================

if [ $infcloud -eq 1 ]
then
	# Overwrite the php-fpm configuration only if it's allowed
	if [ $overwrite_phpfpm -eq 1 ]
	then
		ynh_config_add_phpfpm
	fi
fi

#=================================================
# UPGRADE RADICALE IN ITS VIRTUALENV
#=================================================
ynh_script_progression "Upgrade Radicale in its virtualenv"

python3 -m venv $install_dir/radicale
$install_dir/radicale/bin/pip install -U radicale==$(ynh_app_upstream_version) python-ldap

# regex.py file is patched to fix the awful commit e807c3d35bea9cfcfcacac83b1b17d748ea15a39 that stop the reading of "rights" file after the first match.
# mv "$install_dir/regex.py" /opt/yunohost/$app/lib/python*/site-packages/radicale/rights/regex.py

# useradd radicale -d /opt/yunohost/$app
chown $app: -R $install_dir/radicale

find $install_dir/radicale/ -type d -exec chmod 2755 {} \;
find $install_dir/radicale/ -type f -exec chmod g+r,o+r {} \;

#=================================================
# CONFIGURE RADICALE
#=================================================
ynh_script_progression "Reconfigure Radicale"

# Overwrite the logging config file only if it's allowed
if [ $overwrite_logging -eq 1 ]
then
	ynh_config_add --template="logging" --destination="/etc/$app/logging"
fi

# Overwrite the config file only if it's allowed
if [ $overwrite_config -eq 1 ]
then
	ynh_config_add --template="config" --destination="/etc/$app/config"
fi

chmod 755 /etc/$app/
chmod 644 /etc/$app/*

# Overwrite the InfCloud config file only if it's allowed
if [ $infcloud -eq 1 ]
then
	if [ $overwrite_infcloud -eq 1 ]
	then
		# InfCloud configuration
		ynh_config_add --template="config.js" --destination="$install_dir/infcloud/config.js"
		chmod 440 "$install_dir/infcloud/config.js"
		chown $app:www-data "$install_dir/infcloud/config.js"
	fi
fi

yunohost service add $app --description="CalDAV and CardDAV synchronization server" --log="/var/log/uwsgi/app/radicale.log"

#=================================================
# SETUP LOGROTATE
#=================================================
ynh_script_progression "Upgrading logrotate configuration..."

mkdir -p /var/log/$app
touch /var/log/$app/$app.log
chown radicale -R /var/log/$app

# Use logrotate to manage app-specific logfile(s)
ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service=uwsgi --action="restart"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
