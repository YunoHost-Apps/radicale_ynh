#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# SAVE THE RADICALE 1.x DATA
#=================================================

if ynh_app_upgrading_from_version_before "3.8.3~ynh1"; then
    ynh_script_progression "Saving a copy of the Radicale 1.x data..."
    _radicale_save_v1_data
fi

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

if [ -e "/etc/systemd/system/$app.service" ]; then
    ynh_systemctl --service="$app" --action="stop"
fi

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

ynh_app_setting_set_default --key=git_history --value=1
ynh_app_setting_set_default --key=sharing_users --value=0
ynh_app_setting_set_default --key=sharing_links --value=0

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading Radicale in its Python virtual environment..."

_radicale_install_venv

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Updating $app's configuration files..."

_radicale_add_config

if ynh_app_upgrading_from_version_before "3.8.3~ynh1"; then
    ynh_script_progression "Migrating from Radicale 1.x..."
    _radicale_migrate_from_v1
fi

_radicale_prepare_data_dir
_radicale_init_git

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

_radicale_ensure_public_access

ynh_config_add_nginx
_radicale_add_wellknown

ynh_config_add_logrotate

ynh_config_add_systemd

yunohost service add "$app" --description="CalDAV and CardDAV server" --log="/var/log/$app/$app.log"

ynh_config_add_fail2ban --logpath="/var/log/$app/$app.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --wait_until="Radicale server ready"

_radicale_v1_migration_done

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
